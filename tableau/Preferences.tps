<?xml version='1.0'?>
<!-- Kopieer naar ~/Documents/My Tableau Repository/Preferences.tps en herstart Tableau.
     Kleuren gecontroleerd op kleurenblindheid (dataviz-validator, 19-11-2026). Grijs is bewust neutraal. -->
<workbook>
  <preferences>
    <color-palette name="ETI segmenten" type="regular">
      <color>#A8A29E</color><color>#E39A2D</color><color>#1F9E89</color><color>#4A5FC1</color><color>#C4457A</color>
    </color-palette>
    <color-palette name="ETI oorzaak prijs" type="regular">
      <color>#A0522D</color><color>#2A9DB5</color><color>#C9961A</color><color>#A8A29E</color>
    </color-palette>
    <color-palette name="ETI focus" type="regular">
      <color>#E39A2D</color><color>#BDBDBD</color>
    </color-palette>
    <color-palette name="ETI haalbaar" type="regular">
      <color>#2E8B57</color><color>#BDBDBD</color>
    </color-palette>
    <color-palette name="ETI capture rate" type="ordered-sequential">
      <color>#B4457A</color><color>#E8C1D4</color><color>#F2F0EE</color><color>#B7D7CF</color><color>#1F7F70</color>
    </color-palette>
    <color-palette name="ETI bronnen" type="regular">
